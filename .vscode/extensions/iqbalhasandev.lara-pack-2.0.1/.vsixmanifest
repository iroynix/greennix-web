<?xml version="1.0" encoding="utf-8"?>
	<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011">
		<Metadata>
			<Identity Language="en-US" Id="lara-pack" Version="2.0.1" Publisher="iqbalhasandev" />
			<DisplayName>Lara Pack</DisplayName>
			<Description xml:space="preserve">Lara Pack is a Official VS Code Laravel Development Environment Extension Pack By IQBAL HASAN! Lara Pack is a collection of popular extensions that can help write, test and debug Laravel applications in Visual Studio Code.Lara Pack contains all the necessary extensions of html, css, js, vue, node, axios, php and laravel and remote ssh.</Description>
			<Tags>lara,pack,lara-pack,laraPack,lara pack,Laravel Development,Laravel Development Environment,Laravel Environment,vscode-lara-pack,Web,Web Design,Web Design  Extension Pack,Web Development,Web Development  Extension Pack,HTML,HTML Extension Pack,CSS,CSS Extension Pack,Js,Js Extension Pack,axios,axios Extension Pack,git ,git Extension Pack,php,php Extension Pack,Laravel,Laravel Extension Pack,Vue Extension Pack,Vue,Vue 3,Vue 2,Composition API,Vue Snippets,Snippets,javascript,node,css,laravel,__web_extension</Tags>
			<Categories>Extension Packs</Categories>
			<GalleryFlags>Public</GalleryFlags>
			
			<Properties>
				<Property Id="Microsoft.VisualStudio.Code.Engine" Value="^1.56.0" />
				<Property Id="Microsoft.VisualStudio.Code.ExtensionDependencies" Value="" />
				<Property Id="Microsoft.VisualStudio.Code.ExtensionPack" Value="formulahendry.auto-close-tag,formulahendry.auto-rename-tag,Yggdrasill-7C9.axios-snippets,aaron-bond.better-comments,streetsidesoftware.code-spell-checker,DEVSENSE.composer-php-vscode,aeschli.vscode-css-formatter,sporiley.css-auto-prefix,mikestead.dotenv,dbaeumer.vscode-eslint,eamodio.gitlens,spywhere.guides,vincaslt.highlight-matching-tag,ecmel.vscode-html-css,wix.vscode-import-cost,zignd.html-css-class-completion,shufo.vscode-blade-formatter,onecentlin.laravel-blade,austenc.laravel-blade-spacer,amiralizadeh9480.laravel-extra-intellisense,codingyu.laravel-goto-view,naoray.laravel-goto-components,hookyqr.minify,christian-kohler.npm-intellisense,christian-kohler.path-intellisense,devsense.phptools-vscode,bmewburn.vscode-intelephense-client,mehedidracula.php-namespace-resolver,esbenp.prettier-vscode,ms-vscode-remote.remote-ssh,ms-vscode-remote.remote-ssh-edit,ms-vscode.remote-explorer,claudineyqr.snippets-creator,xshrim.txt-syntax,vue.volar,codezombiech.gitignore,bradgashler.htmltagwrap" />
				<Property Id="Microsoft.VisualStudio.Code.ExtensionKind" Value="workspace,web" />
				<Property Id="Microsoft.VisualStudio.Code.LocalizedLanguages" Value="" />
				
				
				<Property Id="Microsoft.VisualStudio.Services.Links.Source" Value="https://github.com/iqbalhasandev/vscode-lara-pack.git" />
				<Property Id="Microsoft.VisualStudio.Services.Links.Getstarted" Value="https://github.com/iqbalhasandev/vscode-lara-pack.git" />
				<Property Id="Microsoft.VisualStudio.Services.Links.GitHub" Value="https://github.com/iqbalhasandev/vscode-lara-pack.git" />
				<Property Id="Microsoft.VisualStudio.Services.Links.Support" Value="https://github.com/iqbalhasandev/vscode-lara-pack/issues" />
				<Property Id="Microsoft.VisualStudio.Services.Links.Learn" Value="https://github.com/iqbalhasandev/vscode-lara-pack/blob/master/README.md" />
				
				
				<Property Id="Microsoft.VisualStudio.Services.GitHubFlavoredMarkdown" Value="true" />
				<Property Id="Microsoft.VisualStudio.Services.Content.Pricing" Value="Free"/>

				
				
			</Properties>
			<License>extension/LICENSE.md</License>
			<Icon>extension/img/icon.jpg</Icon>
		</Metadata>
		<Installation>
			<InstallationTarget Id="Microsoft.VisualStudio.Code"/>
		</Installation>
		<Dependencies/>
		<Assets>
			<Asset Type="Microsoft.VisualStudio.Code.Manifest" Path="extension/package.json" Addressable="true" />
			<Asset Type="Microsoft.VisualStudio.Services.Content.Details" Path="extension/README.md" Addressable="true" />
<Asset Type="Microsoft.VisualStudio.Services.Content.Changelog" Path="extension/CHANGELOG.md" Addressable="true" />
<Asset Type="Microsoft.VisualStudio.Services.Content.License" Path="extension/LICENSE.md" Addressable="true" />
<Asset Type="Microsoft.VisualStudio.Services.Icons.Default" Path="extension/img/icon.jpg" Addressable="true" />
		</Assets>
	</PackageManifest>